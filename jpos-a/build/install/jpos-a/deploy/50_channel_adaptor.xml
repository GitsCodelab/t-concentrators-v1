<?xml version="1.0" encoding="UTF-8"?>

<channel-adaptor
    name="jpos-a-to-b"
    logger="Q2">

    <channel
        class="org.jpos.iso.channel.NACChannel"
        packager="org.jpos.iso.packager.GenericPackager"
        logger="Q2">

        <property
            name="packager-config"
            value="cfg/iso87.xml"/>

        <property
            name="host"
            value="127.0.0.1"/>

        <property
            name="port"
            value="10000"/>

    </channel>

    <in>jpos-a-to-b-send</in>
    <out>jpos-a-to-b-receive</out>

</channel-adaptor>